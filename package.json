{
  "name": "appro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:artifact": "vite build --mode artifact && node scripts/to-artifact.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "mail:prueba": "tsx --env-file-if-exists=.env.local server/probar-mail.ts",
    "test:reglas": "firebase emulators:exec --only firestore,storage --project demo-appro \"vitest run -c vitest.reglas.config.ts\"",
    "emuladores": "firebase emulators:start --project demo-appro",
    "sembrar": "tsx --env-file-if-exists=.env.local server/sembrar.ts",
    "avisos": "tsx --env-file-if-exists=.env.local server/avisos.ts",
    "admin": "tsx --env-file-if-exists=.env.local server/admin.ts",
    "desplegar:reglas": "firebase deploy --only firestore"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/node": "^22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "firebase-admin": "14.4.0",
    "firebase-tools": "15.33.0",
    "tsx": "^4.19.2",
    "typescript": "5.6.3",
    "vite": "6.0.3",
    "vite-plugin-singlefile": "2.1.0",
    "vitest": "2.1.8"
  }
}
