rules_version = '2';

// APPRO · reglas de Firestore
//
// users/{uid}                          perfil público: empresa, contacto, categoría, sector, ubicación, CUIT, logo
// users/{uid}/privado/contacto         email y teléfono
// users/{uid}/aceptados/{prov}         el comprador {uid} aceptó la solicitud del proveedor {prov}
// estado/{uid}                         plan, verificaciones: solo lo escribe el equipo (consola o script)
// solicitudes/{id}                     pedido de contacto de un proveedor a un comprador
// pedidos/{id}                         pedido de cotización: ítems, cierre, privado/invitados, sobre cerrado
// pedidos/{id}/cotizaciones/{prov}     la oferta de cada proveedor, ítem por ítem (una por proveedor)
// pedidos/{id}/avisos/{prov}           a quién se avisó por mail (lo escribe el script de avisos)
// solicitudesPlan/{uid}                el proveedor pide pasar a un plan pago
// valoresReferencia/{id}               valores de referencia: los edita un administrador desde /admin/valores
// indicePrecios/{id}, config/{doc}     datos de referencia: solo lectura
// admins/{uid}                         cuentas del equipo que editan valores (se crean desde la consola)
// resenas/{id}                         calificación del comprador a cada proveedor que ganó su pedido
//
// Contacto (mail y teléfono):
//   - el comprador ve el contacto de los proveedores
//   - el proveedor ve el contacto de un comprador SOLO si ese comprador aceptó su solicitud
//   - entre proveedores, o entre compradores, no
// La misma política está en src/domain/acceso.ts (puedeVerContacto).
//
// Las colecciones se crean solas la primera vez que la app escribe en ellas.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Ayudas
    function autenticado() { return request.auth != null; }
    function esDuenio(uid) { return autenticado() && request.auth.uid == uid; }
    function perfil(uid) { return get(/databases/$(database)/documents/users/$(uid)); }
    function tienePerfil() {
      return autenticado() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function miRol() { return perfil(request.auth.uid).data.rol; }
    function rolDe(uid) { return perfil(uid).data.rol; }
    function texto(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function textoOpcional(d, campo, max) {
      return !(campo in d) || (d[campo] is string && d[campo].size() <= max);
    }
    function rubroValido(r) {
      return r in ['packaging', 'frio', 'mantenimiento', 'etiquetas', 'quimicos', 'cargas', 'seguridad'];
    }
    function sinCambios(campos) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(campos);
    }
    function soloCambia(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // ── Perfiles
    function logoValido(d) {
      return !('logoUrl' in d) || d.logoUrl == null
        || (d.logoUrl is string && d.logoUrl.size() <= 200000
            && (d.logoUrl.matches('^https://.*') || d.logoUrl.matches('^data:image/(png|jpeg|webp);base64,.*')));
    }

    function perfilValido(d) {
      return d.keys().hasOnly(['rol', 'empresa', 'contactoNombre', 'categoria', 'sector', 'ubicacion', 'cuit', 'logoUrl',
                               'avisos', 'rubros', 'region', 'creado', 'actualizado'])
        && d.keys().hasAll(['rol', 'empresa', 'contactoNombre', 'categoria', 'ubicacion', 'cuit'])
        && d.rol in ['comprador', 'proveedor']
        && texto(d.empresa, 2, 120)
        && texto(d.contactoNombre, 2, 80)
        && rubroValido(d.categoria)
        && texto(d.ubicacion, 2, 120)
        && d.cuit is string && d.cuit.matches('^[0-9]{2}-[0-9]{8}-[0-9]$')
        && textoOpcional(d, 'sector', 80)
        && (!('avisos' in d) || d.avisos in ['inmediato', 'diario', 'pausado'])
        && (!('rubros' in d) || (d.rubros is list && d.rubros.size() <= 7))
        && (!('region' in d) || d.region in ['ros', 'amba', 'cba', 'noa', 'costa'])
        && logoValido(d);
    }

    function contactoValido(d) {
      return d.keys().hasOnly(['email', 'telefono'])
        && d.email is string && d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') && d.email.size() <= 254
        && d.telefono is string && d.telefono.size() <= 30;
    }

    function aceptoA(compradorUid, proveedorUid) {
      return exists(/databases/$(database)/documents/users/$(compradorUid)/aceptados/$(proveedorUid));
    }

    function puedeVerContacto(uid) {
      let lector = miRol();
      let duenio = rolDe(uid);
      return (lector == 'proveedor' && duenio == 'comprador' && aceptoA(uid, request.auth.uid))
          || (lector == 'comprador' && duenio == 'proveedor');
    }

    match /users/{uid} {
      // Solo usuarios registrados (con perfil) recorren la red. Cada uno siempre lee el suyo.
      allow read: if esDuenio(uid) || tienePerfil();
      allow create: if esDuenio(uid) && perfilValido(request.resource.data);
      // Rol, CUIT y fecha de alta quedan fijos.
      allow update: if esDuenio(uid) && perfilValido(request.resource.data) && sinCambios(['rol', 'cuit', 'creado']);
      // La baja la hace el equipo (Ley 25.326: supresión a pedido), no el cliente.
      allow delete: if false;

      match /privado/{doc} {
        allow read: if doc == 'contacto' && (esDuenio(uid) || (tienePerfil() && puedeVerContacto(uid)));
        allow create, update: if doc == 'contacto' && esDuenio(uid) && contactoValido(request.resource.data);
        allow delete: if false;
      }

      // Solo el comprador acepta (o revoca) a un proveedor. El proveedor puede ver si fue aceptado.
      match /aceptados/{prov} {
        allow read: if esDuenio(uid) || (autenticado() && request.auth.uid == prov);
        allow create: if esDuenio(uid)
          && rolDe(uid) == 'comprador'
          && rolDe(prov) == 'proveedor'
          && request.resource.data.keys().hasOnly(['aceptado'])
          && request.resource.data.aceptado == request.time;
        allow update: if false;
        allow delete: if esDuenio(uid);
      }
    }

    // Plan y verificaciones: los define el equipo, nunca el usuario.
    match /estado/{uid} {
      allow read: if tienePerfil();
      allow write: if false;
    }

    // ── Solicitudes de contacto
    match /solicitudes/{id} {
      allow read: if autenticado()
        && (resource.data.proveedorId == request.auth.uid || resource.data.compradorId == request.auth.uid);
      allow create: if autenticado()
        && request.resource.data.keys().hasOnly(['proveedorId', 'compradorId', 'motivo', 'estado', 'creada'])
        && request.resource.data.proveedorId == request.auth.uid
        && miRol() == 'proveedor'
        && rolDe(request.resource.data.compradorId) == 'comprador'
        && request.resource.data.estado == 'pendiente'
        && texto(request.resource.data.motivo, 40, 300)
        && request.resource.data.creada == request.time;
      // Solo el comprador responde, y solo cambia el estado.
      allow update: if autenticado()
        && resource.data.compradorId == request.auth.uid
        && soloCambia(['estado'])
        && resource.data.estado in ['pendiente', 'postergada']
        && request.resource.data.estado in ['aceptada', 'postergada', 'rechazada'];
      allow delete: if false;
    }

    // ── Pedidos de cotización
    // Privado: solo lo ven el comprador, los invitados y quien lo ganó. Sobre cerrado: el comprador lee las
    // ofertas recién después de cierraEn. Después de cierraEn nadie cotiza. Un pedido del formato anterior
    // (sin "privado") lo ve solo su comprador hasta correr `npm run admin -- migrar-pedidos`.
    // Cada condición se prueba contra las consultas de la app (privado == false, invitados o adjudicados
    // array-contains, compradorId ==). Ojo: sumar algo como !('privado' in d) deja listar la colección entera.
    function puedeVerPedido(d) {
      return d.privado == false
        || d.compradorId == request.auth.uid
        || request.auth.uid in d.invitados
        || request.auth.uid in d.adjudicados;
    }
    function preciosAbiertos(d) { return d.get('sobreCerrado', false) == false || request.time >= d.cierraEn; }
    function recibeOfertas(d) { return d.estado == 'abierto' && (!('cierraEn' in d) || request.time < d.cierraEn); }
    function pedido(id) { return get(/databases/$(database)/documents/pedidos/$(id)).data; }
    function cotizo(id, prov) { return exists(/databases/$(database)/documents/pedidos/$(id)/cotizaciones/$(prov)); }
    function lista(v, max) { return v is list && v.size() <= max; }
    function camposPedido() {
      return ['compradorId', 'titulo', 'descripcion', 'rubro', 'items', 'cantidad', 'unidad', 'entrega', 'pago', 'zona', 'cierre', 'cierraEn',
              'privado', 'invitados', 'sobreCerrado', 'documentos', 'adjuntos', 'ofertas', 'estado', 'creado', 'avisado'];
    }
    function pedidoNuevoValido(d) {
      return d.keys().hasOnly(camposPedido()) && d.keys().hasAll(camposPedido())
        && d.compradorId == request.auth.uid
        && d.estado == 'abierto' && d.avisado == false && d.ofertas == 0
        && d.creado == request.time
        && texto(d.titulo, 6, 140)
        && texto(d.descripcion, 0, 1000)
        && rubroValido(d.rubro)
        && d.items is list && d.items.size() >= 1 && d.items.size() <= 30
        && d.cantidad is number && d.cantidad > 0
        && texto(d.unidad, 1, 40)
        && texto(d.entrega, 1, 140)
        && texto(d.pago, 1, 60)
        && texto(d.zona, 0, 80)
        && d.cierre is string && d.cierre.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.cierraEn is timestamp && d.cierraEn > request.time
        && d.privado is bool && d.sobreCerrado is bool
        && lista(d.invitados, 30)
        && (d.privado ? d.invitados.size() >= 1 : d.invitados.size() == 0)
        && lista(d.documentos, 10)
        && lista(d.adjuntos, 10);
    }
    // Hasta 5 proveedores adjudicados, cada uno con su oferta; el principal (adjudicadaA) va primero.
    function adjudicacionValida(id, d) {
      return d.adjudicados is list && d.adjudicados.size() >= 1 && d.adjudicados.size() <= 5
        && d.adjudicados.toSet().size() == d.adjudicados.size()
        && d.adjudicadaA == d.adjudicados[0]
        && d.adjudicacion is map && d.adjudicacion.size() >= 1 && d.adjudicacion.size() <= resource.data.get('items', [0]).size()
        && d.adjudicacion.values().toSet() == d.adjudicados.toSet()
        && texto(d.get('comentarioAdjudicacion', ''), 0, 1000)
        && cotizo(id, d.adjudicados[0])
        && (d.adjudicados.size() < 2 || cotizo(id, d.adjudicados[1]))
        && (d.adjudicados.size() < 3 || cotizo(id, d.adjudicados[2]))
        && (d.adjudicados.size() < 4 || cotizo(id, d.adjudicados[3]))
        && (d.adjudicados.size() < 5 || cotizo(id, d.adjudicados[4]));
    }

    match /pedidos/{id} {
      allow read: if tienePerfil() && puedeVerPedido(resource.data);
      allow create: if autenticado() && miRol() == 'comprador' && pedidoNuevoValido(request.resource.data);
      allow update: if autenticado() && (
        // El comprador adjudica (con sobre cerrado, después del cierre) a proveedores que cotizaron.
        (resource.data.compradorId == request.auth.uid
          && resource.data.estado == 'abierto'
          && preciosAbiertos(resource.data)
          && soloCambia(['estado', 'adjudicadaA', 'adjudicados', 'adjudicacion', 'comentarioAdjudicacion'])
          && request.resource.data.estado == 'adjudicado'
          && adjudicacionValida(id, request.resource.data))
        // Un proveedor suma 1 al contador en el mismo lote en que crea su oferta.
        || (miRol() == 'proveedor'
          && recibeOfertas(resource.data)
          && soloCambia(['ofertas'])
          && request.resource.data.ofertas == resource.data.get('ofertas', 0) + 1
          && !cotizo(id, request.auth.uid)
          && existsAfter(/databases/$(database)/documents/pedidos/$(id)/cotizaciones/$(request.auth.uid)))
      );
      allow delete: if false;

      // Cada proveedor ve solo su oferta; el comprador ve todas las de su pedido, con sobre cerrado después del cierre.
      match /cotizaciones/{prov} {
        allow read: if autenticado()
          && (request.auth.uid == prov || (pedido(id).compradorId == request.auth.uid && preciosAbiertos(pedido(id))));
        allow create: if autenticado()
          && request.auth.uid == prov
          && miRol() == 'proveedor'
          && recibeOfertas(pedido(id))
          && (pedido(id).get('privado', false) == false || prov in pedido(id).invitados)
          && request.resource.data.keys().hasOnly(['pedidoId', 'proveedorId', 'items', 'precioUnitario', 'plazoDias', 'vigencia', 'pago', 'nota', 'adjuntos', 'creada'])
          && request.resource.data.keys().hasAll(['pedidoId', 'proveedorId', 'items', 'precioUnitario', 'plazoDias', 'vigencia', 'pago', 'nota', 'adjuntos', 'creada'])
          && request.resource.data.pedidoId == id
          && request.resource.data.proveedorId == prov
          && request.resource.data.items is list && request.resource.data.items.size() == pedido(id).get('items', [0]).size()
          && request.resource.data.precioUnitario is number && request.resource.data.precioUnitario > 0
          && request.resource.data.plazoDias is int && request.resource.data.plazoDias >= 0 && request.resource.data.plazoDias <= 365
          && request.resource.data.vigencia is string && request.resource.data.vigencia.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && texto(request.resource.data.pago, 1, 60)
          && texto(request.resource.data.nota, 0, 500)
          && lista(request.resource.data.adjuntos, 10)
          && request.resource.data.creada == request.time
          // El contador del pedido sube en el mismo lote.
          && getAfter(/databases/$(database)/documents/pedidos/$(id)).data.ofertas == pedido(id).get('ofertas', 0) + 1;
        allow update, delete: if false;
      }

      match /avisos/{prov} {
        allow read: if autenticado() && get(/databases/$(database)/documents/pedidos/$(id)).data.compradorId == request.auth.uid;
        allow write: if false;
      }
    }

    // Para que el proveedor cuente sus propias cotizaciones (cupo del plan).
    match /{camino=**}/cotizaciones/{prov} {
      allow read: if autenticado() && resource.data.proveedorId == request.auth.uid;
    }

    // ── Planes: el proveedor lo pide, el equipo lo activa en estado/{uid}.
    match /solicitudesPlan/{uid} {
      allow read: if esDuenio(uid);
      allow create, update: if esDuenio(uid)
        && miRol() == 'proveedor'
        && request.resource.data.keys().hasOnly(['plan', 'pedido'])
        && request.resource.data.plan in ['gratis', 'pro', 'empresa']
        && request.resource.data.pedido == request.time;
      allow delete: if false;
    }

    // ── Administradores: se agregan a mano desde la consola (documento admins/{uid}).
    function esAdmin() { return autenticado() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    match /admins/{uid} {
      allow read: if esDuenio(uid);
      allow write: if false;
    }

    // ── Referencias. Los valores los edita un administrador; el resto lo carga el equipo (scripts/sembrar.ts).
    function numeroOpcional(d, campo) { return !(campo in d) || (d[campo] is number && d[campo] >= 0); }
    function valorValido(d) {
      return d.keys().hasOnly(['rubro', 'concepto', 'tipo', 'unidad', 'principal', 'region', 'min', 'mediana', 'max',
                               'muestras', 'fuente', 'fuenteDetalle', 'fecha', 'actualizado', 'actualizadoPor'])
        && rubroValido(d.rubro)
        && texto(d.concepto, 2, 160)
        && d.tipo in ['hora', 'unidad', 'proyecto']
        && texto(d.unidad, 1, 40)
        && d.region in ['ros', 'amba', 'cba', 'noa', 'costa', 'nacional']
        && d.min is number && d.mediana is number && d.max is number
        && d.min >= 0 && d.min <= d.mediana && d.mediana <= d.max
        && numeroOpcional(d, 'muestras')
        && (!('principal' in d) || d.principal is bool)
        && (!('fuente' in d) || d.fuente in ['cotizaciones', 'arancel', 'convenio', 'estimado'])
        && textoOpcional(d, 'fuenteDetalle', 200)
        && (!('fecha' in d) || (d.fecha is string && d.fecha.matches('^[0-9]{4}-[0-9]{2}$')))
        && d.actualizado == request.time
        && d.actualizadoPor == request.auth.uid;
    }
    match /valoresReferencia/{id} {
      allow read: if tienePerfil();
      allow create, update: if esAdmin() && valorValido(request.resource.data);
      allow delete: if false;
    }
    match /indicePrecios/{id} { allow read: if tienePerfil(); allow write: if false; }
    match /config/{doc} { allow read: if tienePerfil(); allow write: if false; }

    // ── Reseñas: una por pedido y proveedor ganador, del comprador que lo publicó. No se editan.
    // El id es el del pedido para el proveedor principal (adjudicadaA) y "{pedido}--{proveedor}" para los demás.
    function puntaje(v) { return v is int && v >= 1 && v <= 5; }
    match /resenas/{rid} {
      allow read: if tienePerfil();
      allow create: if autenticado()
        && request.resource.data.keys().hasOnly(['pedidoId', 'proveedorId', 'compradorId', 'entrega', 'calidad', 'facturacion', 'texto', 'autor', 'empresa', 'creada'])
        && request.resource.data.compradorId == request.auth.uid
        && pedido(request.resource.data.pedidoId).compradorId == request.auth.uid
        && pedido(request.resource.data.pedidoId).estado == 'adjudicado'
        && ((rid == request.resource.data.pedidoId && pedido(request.resource.data.pedidoId).adjudicadaA == request.resource.data.proveedorId)
          || (rid == request.resource.data.pedidoId + '--' + request.resource.data.proveedorId
              && request.resource.data.proveedorId in pedido(request.resource.data.pedidoId).get('adjudicados', [])))
        && puntaje(request.resource.data.entrega)
        && puntaje(request.resource.data.calidad)
        && puntaje(request.resource.data.facturacion)
        && texto(request.resource.data.texto, 20, 500)
        && texto(request.resource.data.autor, 1, 120)
        && texto(request.resource.data.empresa, 0, 120)
        && request.resource.data.creada == request.time;
      allow update, delete: if false;
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
