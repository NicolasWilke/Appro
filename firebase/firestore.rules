rules_version = '2';

// APPRO · reglas de Firestore
//
// users/{uid}                          perfil público: empresa, contacto, categoría, sector, ubicación, CUIT, logo
// users/{uid}/privado/contacto         email y teléfono
// users/{uid}/aceptados/{prov}         el comprador {uid} aceptó la solicitud del proveedor {prov}
// estado/{uid}                         plan, verificaciones: solo lo escribe el equipo (/admin/cuentas, consola o script)
// solicitudes/{id}                     pedido de contacto de un proveedor a un comprador
// pedidos/{id}                         pedido de cotización: ítems, cierre, privado/invitados, sobre cerrado
// pedidos/{id}/cotizaciones/{prov}     la oferta de cada proveedor, ítem por ítem (una por proveedor)
// pedidos/{id}/avisos/{prov}           a quién se avisó por mail (lo escribe el script de avisos)
// solicitudesPlan/{uid}                el proveedor pide pasar a un plan pago
// usos/{uid}                           contador del mes (UTC) de solicitudes y ofertas: hace cumplir el cupo del plan
// valoresReferencia/{id}               valores de referencia: los edita un administrador desde /admin/valores
// indicePrecios/{id}, config/{doc}     datos de referencia: solo lectura
// indicadores/{id}, escalas/{id}        índices oficiales y escalas de convenio: los carga un admin en /admin/indices
// admins/{uid}                         cuentas del equipo que editan valores (se crean desde la consola)
// resenas/{id}                         calificación del comprador a cada proveedor que ganó su pedido
// miembros/{uid}                       usuario del equipo comercial de un proveedor Empresa (actúa por empresaId)
// equipos/{empresa}                    lista de miembros de la empresa: hasta 4, más el titular
// invitaciones/{codigo}                enlace de un solo uso, 7 días, para sumarse al equipo
// users/{uid}/metricas/vistas          cuántas veces lo vieron compradores (embudo del proveedor), sin decir quién
// bajas/{uid}                          el usuario pide borrar su cuenta; el script de avisos la borra en la próxima corrida
// listaEspera/{uid}                    un comprador se anota para el plan Equipo
//
// Equipo (plan Empresa): un miembro no tiene perfil propio. Mientras la empresa tenga el plan Empresa, las reglas
// lo tratan como a la empresa (miEmpresa / actuaPor) para pedidos, ofertas, solicitudes y consultas. No edita el
// perfil, no pide planes ni maneja el equipo: eso es del titular. Si la empresa baja de plan, el miembro pierde acceso.
//
// Contacto (mail y teléfono):
//   - el comprador ve el contacto de los proveedores
//   - el proveedor ve el contacto de un comprador SOLO si ese comprador aceptó su solicitud
//   - entre proveedores, o entre compradores, no
// La misma política está en src/domain/acceso.ts (puedeVerContacto).
//
// Las colecciones se crean solas la primera vez que la app escribe en ellas.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Ayudas
    function autenticado() { return request.auth != null; }
    function esDuenio(uid) { return autenticado() && request.auth.uid == uid; }
    function perfil(uid) { return get(/databases/$(database)/documents/users/$(uid)); }
    // Equipo: miembros/{uid} cuenta solo mientras la empresa tenga el plan Empresa.
    function miembroRuta() { return /databases/$(database)/documents/miembros/$(request.auth.uid); }
    function miembroVigente() {
      return autenticado() && exists(miembroRuta()) && planDe(get(miembroRuta()).data.empresaId) == 'empresa';
    }
    // La cuenta por la que actúa quien escribe: la empresa si es miembro de un equipo, si no la propia.
    function miEmpresa() { return miembroVigente() ? get(miembroRuta()).data.empresaId : request.auth.uid; }
    function actuaPor(uid) { return autenticado() && (request.auth.uid == uid || miEmpresa() == uid); }
    function tienePerfil() {
      return autenticado() && (exists(/databases/$(database)/documents/users/$(request.auth.uid)) || miembroVigente());
    }
    function miRol() { return perfil(miEmpresa()).data.rol; }
    function rolDe(uid) { return perfil(uid).data.rol; }
    function texto(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function textoOpcional(d, campo, max) {
      return !(campo in d) || (d[campo] is string && d[campo].size() <= max);
    }
    function rubroValido(r) {
      return r in ['packaging', 'frio', 'mantenimiento', 'etiquetas', 'quimicos', 'cargas', 'seguridad', 'limpieza'];
    }
    function sinCambios(campos) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(campos);
    }
    function soloCambia(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }
    // Plan vigente: lo escribe el equipo en estado/{uid}; sin documento, Gratis.
    function planDe(uid) {
      let ruta = /databases/$(database)/documents/estado/$(uid);
      return exists(ruta) ? get(ruta).data.get('plan', 'gratis') : 'gratis';
    }
    function regionValida(r) { return r in ['ros', 'amba', 'cba', 'noa', 'costa']; }

    // ── Perfiles
    function logoValido(d) {
      return !('logoUrl' in d) || d.logoUrl == null
        || (d.logoUrl is string && d.logoUrl.size() <= 200000
            && (d.logoUrl.matches('^https://.*') || d.logoUrl.matches('^data:image/(png|jpeg|webp);base64,.*')));
    }

    function perfilValido(d) {
      return d.keys().hasOnly(['rol', 'empresa', 'contactoNombre', 'categoria', 'sector', 'ubicacion', 'cuit', 'logoUrl',
                               'avisos', 'rubros', 'region', 'regiones', 'creado', 'actualizado'])
        && d.keys().hasAll(['rol', 'empresa', 'contactoNombre', 'categoria', 'ubicacion', 'cuit'])
        && d.rol in ['comprador', 'proveedor']
        && texto(d.empresa, 2, 120)
        && texto(d.contactoNombre, 2, 80)
        && rubroValido(d.categoria)
        && texto(d.ubicacion, 2, 120)
        && d.cuit is string && d.cuit.matches('^[0-9]{2}-[0-9]{8}-[0-9]$')
        && textoOpcional(d, 'sector', 80)
        && (!('avisos' in d) || d.avisos in ['inmediato', 'diario', 'pausado'])
        && (!('rubros' in d) || (d.rubros is list && d.rubros.size() <= 7))
        && (!('region' in d) || d.region in ['ros', 'amba', 'cba', 'noa', 'costa'])
        && logoValido(d);
    }

    // Regiones que el proveedor suma a la principal. Sumar es del plan Empresa; si baja de plan, las que ya tenía
    // pueden quedar guardadas (la app deja de mostrarlas) para que pueda seguir editando el resto del perfil.
    function regionesValidas(uid, d) {
      return !('regiones' in d)
        || (d.regiones is list && d.regiones.size() <= 4 && d.regiones.hasOnly(['ros', 'amba', 'cba', 'noa', 'costa'])
            && (d.regiones.size() == 0
                || planDe(uid) == 'empresa'
                || (resource != null && resource.data.get('regiones', []) == d.regiones)));
    }

    function contactoValido(d) {
      return d.keys().hasOnly(['email', 'telefono'])
        && d.email is string && d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') && d.email.size() <= 254
        && d.telefono is string && d.telefono.size() <= 30;
    }

    function aceptoA(compradorUid, proveedorUid) {
      return exists(/databases/$(database)/documents/users/$(compradorUid)/aceptados/$(proveedorUid));
    }

    function puedeVerContacto(uid) {
      let lector = miRol();
      let duenio = rolDe(uid);
      return (lector == 'proveedor' && duenio == 'comprador' && aceptoA(uid, miEmpresa()))
          || (lector == 'comprador' && duenio == 'proveedor');
    }

    match /users/{uid} {
      // Solo usuarios registrados (con perfil) recorren la red. Cada uno siempre lee el suyo.
      allow read: if esDuenio(uid) || tienePerfil();
      // Un miembro de un equipo no tiene perfil propio.
      allow create: if esDuenio(uid) && perfilValido(request.resource.data) && regionesValidas(uid, request.resource.data)
        && !exists(/databases/$(database)/documents/miembros/$(uid));
      // Rol, CUIT y fecha de alta quedan fijos.
      allow update: if esDuenio(uid) && perfilValido(request.resource.data) && regionesValidas(uid, request.resource.data)
        && sinCambios(['rol', 'cuit', 'creado']);
      // La baja la hace el equipo (Ley 25.326: supresión a pedido), no el cliente.
      allow delete: if false;

      match /privado/{doc} {
        allow read: if doc == 'contacto' && (actuaPor(uid) || esAdmin() || (tienePerfil() && puedeVerContacto(uid)));
        allow create, update: if doc == 'contacto' && esDuenio(uid) && contactoValido(request.resource.data);
        allow delete: if false;
      }

      // Solo el comprador acepta (o revoca) a un proveedor. El proveedor puede ver si fue aceptado.
      match /aceptados/{prov} {
        allow read: if esDuenio(uid) || actuaPor(prov);
        allow create: if esDuenio(uid)
          && rolDe(uid) == 'comprador'
          && rolDe(prov) == 'proveedor'
          && request.resource.data.keys().hasOnly(['aceptado'])
          && request.resource.data.aceptado == request.time;
        allow update: if false;
        allow delete: if esDuenio(uid);
      }

      // Proveedores favoritos del comprador: privados, solo los ve y cambia él.
      match /favoritos/{prov} {
        allow read, delete: if esDuenio(uid);
        allow create: if esDuenio(uid)
          && rolDe(uid) == 'comprador'
          && rolDe(prov) == 'proveedor'
          && request.resource.data.keys().hasOnly(['desde'])
          && request.resource.data.desde == request.time;
        allow update: if false;
      }

      // Vistas del perfil de un proveedor: solo un comprador suma, de a uno, y solo el proveedor lee el total.
      // Es un contador y no una lista: el proveedor no sabe quién lo miró.
      match /metricas/{doc} {
        allow read: if doc == 'vistas' && actuaPor(uid);
        allow create: if doc == 'vistas' && tienePerfil() && miRol() == 'comprador' && rolDe(uid) == 'proveedor'
          && request.resource.data.keys().hasOnly(['total']) && request.resource.data.total == 1;
        allow update: if doc == 'vistas' && tienePerfil() && miRol() == 'comprador' && rolDe(uid) == 'proveedor'
          && request.resource.data.keys().hasOnly(['total']) && request.resource.data.total == resource.data.total + 1;
        allow delete: if false;
      }
    }

    // Plan y verificaciones: los define el equipo (un admin desde /admin/cuentas), nunca el usuario.
    function verificacionesValidas(v) {
      return v is map && v.keys().hasOnly(['idFiscal', 'mailCorporativo', 'cargoRevisado'])
        && v.get('idFiscal', false) is bool && v.get('mailCorporativo', false) is bool && v.get('cargoRevisado', false) is bool;
    }
    match /estado/{uid} {
      allow read: if tienePerfil();
      allow create, update: if esAdmin()
        && request.resource.data.keys().hasOnly(['plan', 'verificaciones', 'tasaRespuesta', 'certificaciones', 'actualizado', 'actualizadoPor'])
        && (!('plan' in request.resource.data) || request.resource.data.plan in ['gratis', 'pro', 'empresa'])
        && (!('verificaciones' in request.resource.data) || verificacionesValidas(request.resource.data.verificaciones))
        && request.resource.data.actualizado == request.time
        && request.resource.data.actualizadoPor == request.auth.uid;
      allow delete: if false;
    }

    // ── Solicitudes de contacto
    match /solicitudes/{id} {
      allow read: if autenticado()
        && (actuaPor(resource.data.proveedorId) || resource.data.compradorId == request.auth.uid);
      allow create: if autenticado()
        && request.resource.data.keys().hasOnly(['proveedorId', 'compradorId', 'motivo', 'estado', 'creada'])
        && actuaPor(request.resource.data.proveedorId)
        && miRol() == 'proveedor'
        && rolDe(request.resource.data.compradorId) == 'comprador'
        && request.resource.data.estado == 'pendiente'
        && texto(request.resource.data.motivo, 40, 300)
        && request.resource.data.creada == request.time
        // El contador del mes sube en el mismo lote y anota esta solicitud (ver usos).
        && getAfter(usoRuta(request.resource.data.proveedorId)).data.get('ultimaSolicitud', '') == id;
      // Solo el comprador responde, y solo cambia el estado.
      allow update: if autenticado()
        && resource.data.compradorId == request.auth.uid
        && soloCambia(['estado'])
        && resource.data.estado in ['pendiente', 'postergada']
        && request.resource.data.estado in ['aceptada', 'postergada', 'rechazada'];
      // Con la solicitud aceptada, el proveedor anota si hubo reunión (embudo). No toca nada más.
      allow update: if autenticado()
        && actuaPor(resource.data.proveedorId)
        && resource.data.estado == 'aceptada'
        && soloCambia(['reunion'])
        && request.resource.data.reunion is bool;
      allow delete: if false;
    }

    // ── Pedidos de cotización
    // Privado: solo lo ven el comprador, los invitados y quien lo ganó. Sobre cerrado: el comprador lee las
    // ofertas recién después de cierraEn. Después de cierraEn nadie cotiza. Un pedido del formato anterior
    // (sin "privado") lo ve solo su comprador hasta correr `npm run admin -- migrar-pedidos`.
    // Cada condición se prueba contra las consultas de la app (privado == false, invitados o adjudicados
    // array-contains, compradorId ==). Ojo: sumar algo como !('privado' in d) deja listar la colección entera.
    function puedeVerPedido(d) {
      return d.privado == false
        || d.compradorId == request.auth.uid
        || miEmpresa() in d.invitados
        || miEmpresa() in d.adjudicados;
    }
    function preciosAbiertos(d) { return d.get('sobreCerrado', false) == false || request.time >= d.cierraEn; }
    function recibeOfertas(d) { return d.estado == 'abierto' && (!('cierraEn' in d) || request.time < d.cierraEn); }
    function pedido(id) { return get(/databases/$(database)/documents/pedidos/$(id)).data; }
    function cotizo(id, prov) { return exists(/databases/$(database)/documents/pedidos/$(id)/cotizaciones/$(prov)); }
    function lista(v, max) { return v is list && v.size() <= max; }
    function camposPedido() {
      return ['compradorId', 'titulo', 'descripcion', 'rubro', 'items', 'cantidad', 'unidad', 'entrega', 'pago', 'zona', 'cierre', 'cierraEn',
              'privado', 'invitados', 'sobreCerrado', 'documentos', 'adjuntos', 'moneda', 'ofertas', 'estado', 'creado', 'avisado'];
    }
    function pedidoNuevoValido(d) {
      return d.keys().hasOnly(camposPedido()) && d.keys().hasAll(camposPedido())
        && d.compradorId == request.auth.uid
        && d.estado == 'abierto' && d.avisado == false && d.ofertas == 0
        && d.creado == request.time
        && texto(d.titulo, 6, 140)
        && texto(d.descripcion, 0, 1000)
        && rubroValido(d.rubro)
        && d.items is list && d.items.size() >= 1 && d.items.size() <= 30
        && d.cantidad is number && d.cantidad > 0
        && texto(d.unidad, 1, 40)
        && texto(d.entrega, 1, 140)
        && texto(d.pago, 1, 60)
        && texto(d.zona, 0, 80)
        && d.cierre is string && d.cierre.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.cierraEn is timestamp && d.cierraEn > request.time
        && d.privado is bool && d.sobreCerrado is bool
        && lista(d.invitados, 30)
        && (d.privado ? d.invitados.size() >= 1 : d.invitados.size() == 0)
        && lista(d.documentos, 10)
        && lista(d.adjuntos, 10)
        && d.moneda in ['ARS', 'USD'];
    }
    // Hasta 5 proveedores adjudicados, cada uno con su oferta; el principal (adjudicadaA) va primero.
    function adjudicacionValida(id, d) {
      return d.adjudicados is list && d.adjudicados.size() >= 1 && d.adjudicados.size() <= 5
        && d.adjudicados.toSet().size() == d.adjudicados.size()
        && d.adjudicadaA == d.adjudicados[0]
        && d.adjudicacion is map && d.adjudicacion.size() >= 1 && d.adjudicacion.size() <= resource.data.get('items', [0]).size()
        && d.adjudicacion.values().toSet() == d.adjudicados.toSet()
        && texto(d.get('comentarioAdjudicacion', ''), 0, 1000)
        && cotizo(id, d.adjudicados[0])
        && (d.adjudicados.size() < 2 || cotizo(id, d.adjudicados[1]))
        && (d.adjudicados.size() < 3 || cotizo(id, d.adjudicados[2]))
        && (d.adjudicados.size() < 4 || cotizo(id, d.adjudicados[3]))
        && (d.adjudicados.size() < 5 || cotizo(id, d.adjudicados[4]));
    }

    match /pedidos/{id} {
      allow read: if tienePerfil() && puedeVerPedido(resource.data);
      allow create: if autenticado() && miRol() == 'comprador' && pedidoNuevoValido(request.resource.data);
      allow update: if autenticado() && (
        // El comprador adjudica (con sobre cerrado, después del cierre) a proveedores que cotizaron.
        (resource.data.compradorId == request.auth.uid
          && resource.data.estado == 'abierto'
          && preciosAbiertos(resource.data)
          && soloCambia(['estado', 'adjudicadaA', 'adjudicados', 'adjudicacion', 'comentarioAdjudicacion'])
          && request.resource.data.estado == 'adjudicado'
          && adjudicacionValida(id, request.resource.data))
        // Un proveedor suma 1 al contador en el mismo lote en que crea su oferta.
        || (miRol() == 'proveedor'
          && recibeOfertas(resource.data)
          && soloCambia(['ofertas'])
          && request.resource.data.ofertas == resource.data.get('ofertas', 0) + 1
          && !cotizo(id, miEmpresa())
          && existsAfter(/databases/$(database)/documents/pedidos/$(id)/cotizaciones/$(miEmpresa())))
      );
      allow delete: if false;

      // Cada proveedor ve solo su oferta; el comprador ve todas las de su pedido, con sobre cerrado después del cierre.
      match /cotizaciones/{prov} {
        allow read: if autenticado()
          && (actuaPor(prov) || (pedido(id).compradorId == request.auth.uid && preciosAbiertos(pedido(id))));
        allow create: if autenticado()
          && actuaPor(prov)
          && miRol() == 'proveedor'
          && recibeOfertas(pedido(id))
          && (pedido(id).get('privado', false) == false || prov in pedido(id).invitados)
          && request.resource.data.keys().hasOnly(['pedidoId', 'proveedorId', 'items', 'precioUnitario', 'plazoDias', 'vigencia', 'pago', 'nota', 'adjuntos', 'tipoCambio', 'creada'])
          && request.resource.data.keys().hasAll(['pedidoId', 'proveedorId', 'items', 'precioUnitario', 'plazoDias', 'vigencia', 'pago', 'nota', 'adjuntos', 'creada'])
          && request.resource.data.pedidoId == id
          && request.resource.data.proveedorId == prov
          && request.resource.data.items is list && request.resource.data.items.size() == pedido(id).get('items', [0]).size()
          && request.resource.data.precioUnitario is number && request.resource.data.precioUnitario > 0
          && request.resource.data.plazoDias is int && request.resource.data.plazoDias >= 0 && request.resource.data.plazoDias <= 365
          && request.resource.data.vigencia is string && request.resource.data.vigencia.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && texto(request.resource.data.pago, 1, 60)
          && texto(request.resource.data.nota, 0, 500)
          && lista(request.resource.data.adjuntos, 10)
          // Dólar oficial del momento (opcional): solo valor, fuente y fecha.
          && (!('tipoCambio' in request.resource.data) || (
            request.resource.data.tipoCambio is map
            && request.resource.data.tipoCambio.keys().hasOnly(['valor', 'fuente', 'fecha'])
            && request.resource.data.tipoCambio.valor is number && request.resource.data.tipoCambio.valor > 0
            && texto(request.resource.data.tipoCambio.fuente, 1, 60)
            && request.resource.data.tipoCambio.fecha is string && request.resource.data.tipoCambio.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
          && request.resource.data.creada == request.time
          // El contador del pedido sube en el mismo lote, y también el del mes del proveedor (ver usos).
          && getAfter(/databases/$(database)/documents/pedidos/$(id)).data.ofertas == pedido(id).get('ofertas', 0) + 1
          && getAfter(usoRuta(prov)).data.get('ultimaOferta', '') == id;
        allow update, delete: if false;
      }

      // Consultas anónimas: no se guarda quién preguntó. Pregunta un proveedor que puede ver el pedido mientras
      // recibe ofertas; responde solo el comprador, una vez. Las leen todos los que ven el pedido.
      match /consultas/{cid} {
        allow read: if tienePerfil() && puedeVerPedido(pedido(id));
        allow create: if tienePerfil()
          && miRol() == 'proveedor'
          && puedeVerPedido(pedido(id))
          && recibeOfertas(pedido(id))
          && request.resource.data.keys().hasOnly(['pregunta', 'respuesta', 'respondida', 'creada'])
          && request.resource.data.keys().hasAll(['pregunta', 'respuesta', 'respondida', 'creada'])
          && texto(request.resource.data.pregunta, 10, 500)
          && request.resource.data.respuesta == null
          && request.resource.data.respondida == null
          && request.resource.data.creada == request.time;
        allow update: if autenticado()
          && pedido(id).compradorId == request.auth.uid
          && resource.data.respuesta == null
          && soloCambia(['respuesta', 'respondida'])
          && texto(request.resource.data.respuesta, 1, 1000)
          && request.resource.data.respondida == request.time;
        allow delete: if false;
      }

      match /avisos/{prov} {
        allow read: if autenticado() && get(/databases/$(database)/documents/pedidos/$(id)).data.compradorId == request.auth.uid;
        allow write: if false;
      }
    }

    // ── Compras recientes: un ítem adjudicado, sin precio ni comprador. Lo ven solo los compradores.
    // Se crea en el mismo lote que la adjudicación (antes del lote el pedido seguía abierto), por eso no se puede inventar.
    match /antecedentes/{aid} {
      allow read: if tienePerfil() && miRol() == 'comprador';
      allow create: if autenticado()
        && request.resource.data.keys().hasOnly(['pedidoId', 'itemId', 'rubro', 'nombre', 'descripcion', 'cantidad', 'unidad', 'zona', 'sectorComprador', 'proveedorId', 'adjudicado'])
        && request.resource.data.keys().hasAll(['pedidoId', 'itemId', 'rubro', 'nombre', 'descripcion', 'cantidad', 'unidad', 'zona', 'sectorComprador', 'proveedorId', 'adjudicado'])
        && aid == request.resource.data.pedidoId + '--' + request.resource.data.itemId
        && get(/databases/$(database)/documents/pedidos/$(request.resource.data.pedidoId)).data.compradorId == request.auth.uid
        && get(/databases/$(database)/documents/pedidos/$(request.resource.data.pedidoId)).data.estado == 'abierto'
        && getAfter(/databases/$(database)/documents/pedidos/$(request.resource.data.pedidoId)).data.estado == 'adjudicado'
        && getAfter(/databases/$(database)/documents/pedidos/$(request.resource.data.pedidoId)).data.adjudicacion[request.resource.data.itemId] == request.resource.data.proveedorId
        && request.resource.data.rubro == get(/databases/$(database)/documents/pedidos/$(request.resource.data.pedidoId)).data.rubro
        && request.resource.data.zona == get(/databases/$(database)/documents/pedidos/$(request.resource.data.pedidoId)).data.zona
        && texto(request.resource.data.nombre, 1, 120)
        && texto(request.resource.data.descripcion, 0, 1000)
        && request.resource.data.cantidad is number && request.resource.data.cantidad > 0
        && texto(request.resource.data.unidad, 1, 30)
        && texto(request.resource.data.sectorComprador, 0, 60)
        && request.resource.data.adjudicado == request.time;
      allow update, delete: if false;
    }

    // Pedido de valor vigente al proveedor que ganó un antecedente: el precio lo ven solo las dos partes.
    match /solicitudesValor/{sid} {
      allow read: if autenticado() && (resource.data.compradorId == request.auth.uid || actuaPor(resource.data.proveedorId));
      allow create: if autenticado()
        && miRol() == 'comprador'
        && request.resource.data.keys().hasOnly(['antecedenteId', 'nombre', 'unidad', 'compradorId', 'proveedorId', 'cantidad', 'mensaje', 'estado', 'creada', 'precioUnitario', 'vigencia', 'nota', 'respondida'])
        && request.resource.data.keys().hasAll(['antecedenteId', 'nombre', 'unidad', 'compradorId', 'proveedorId', 'cantidad', 'mensaje', 'estado', 'creada', 'precioUnitario', 'vigencia', 'nota', 'respondida'])
        && request.resource.data.compradorId == request.auth.uid
        && request.resource.data.proveedorId == get(/databases/$(database)/documents/antecedentes/$(request.resource.data.antecedenteId)).data.proveedorId
        && request.resource.data.nombre == get(/databases/$(database)/documents/antecedentes/$(request.resource.data.antecedenteId)).data.nombre
        && request.resource.data.unidad == get(/databases/$(database)/documents/antecedentes/$(request.resource.data.antecedenteId)).data.unidad
        && request.resource.data.cantidad is number && request.resource.data.cantidad > 0
        && texto(request.resource.data.mensaje, 0, 500)
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.precioUnitario == null
        && request.resource.data.vigencia == null
        && request.resource.data.nota == null
        && request.resource.data.respondida == null
        && request.resource.data.creada == request.time;
      allow update: if autenticado()
        && actuaPor(resource.data.proveedorId)
        && resource.data.estado == 'pendiente'
        && request.resource.data.respondida == request.time
        && ((request.resource.data.estado == 'respondida'
            && soloCambia(['estado', 'precioUnitario', 'vigencia', 'nota', 'respondida'])
            && request.resource.data.precioUnitario is number && request.resource.data.precioUnitario > 0
            && request.resource.data.vigencia is string && request.resource.data.vigencia.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && texto(request.resource.data.nota, 0, 500))
          || (request.resource.data.estado == 'declinada' && soloCambia(['estado', 'respondida'])));
      allow delete: if false;
    }

    // Para que el proveedor cuente sus propias cotizaciones (cupo del plan).
    match /{camino=**}/cotizaciones/{prov} {
      allow read: if autenticado() && actuaPor(resource.data.proveedorId);
    }

    // ── Planes: el proveedor lo pide, el equipo lo activa en estado/{uid}.
    match /solicitudesPlan/{uid} {
      allow read: if esDuenio(uid) || esAdmin();
      // Un admin la cierra al activar el plan (o al descartarla).
      allow delete: if esAdmin();
      allow create, update: if esDuenio(uid)
        && miRol() == 'proveedor'
        && request.resource.data.keys().hasOnly(['plan', 'pedido'])
        && request.resource.data.plan in ['gratis', 'pro', 'empresa']
        && request.resource.data.pedido == request.time;
    }

    // ── Cupo del plan. usos/{prov} cuenta las solicitudes y ofertas del mes (UTC). Sube de a uno, en el mismo lote
    // que la solicitud o la oferta nueva que anota (ultimaSolicitud / ultimaOferta), y nunca pasa el límite del plan.
    // Las solicitudes y las ofertas no se borran: un id ya anotado no se puede volver a crear.
    function usoRuta(uid) { return /databases/$(database)/documents/usos/$(uid); }
    function mesActual() {
      let m = request.time.month();
      return string(request.time.year()) + (m < 10 ? '-0' : '-') + string(m);
    }
    function usadoAntes(campo) {
      return (resource == null || resource.data.get('mes', '') != mesActual()) ? 0 : resource.data.get(campo, 0);
    }
    function anterior(campo) { return resource == null ? '' : resource.data.get(campo, ''); }
    function limiteSolicitudes(plan) { return { 'gratis': 3, 'pro': 25, 'empresa': 80 }[plan]; }
    function limiteRespuestas(plan) { return plan == 'gratis' ? 3 : 1000000; }
    function sumaSolicitud(prov, d) {
      return d.solicitudes == usadoAntes('solicitudes') + 1
        && d.respuestas == usadoAntes('respuestas')
        && d.get('ultimaOferta', '') == anterior('ultimaOferta')
        && d.solicitudes <= limiteSolicitudes(planDe(prov))
        && d.ultimaSolicitud is string
        && !exists(/databases/$(database)/documents/solicitudes/$(d.ultimaSolicitud))
        && getAfter(/databases/$(database)/documents/solicitudes/$(d.ultimaSolicitud)).data.proveedorId == prov;
    }
    function sumaOferta(prov, d) {
      return d.respuestas == usadoAntes('respuestas') + 1
        && d.solicitudes == usadoAntes('solicitudes')
        && d.get('ultimaSolicitud', '') == anterior('ultimaSolicitud')
        && d.respuestas <= limiteRespuestas(planDe(prov))
        && d.ultimaOferta is string
        && !exists(/databases/$(database)/documents/pedidos/$(d.ultimaOferta)/cotizaciones/$(prov))
        && existsAfter(/databases/$(database)/documents/pedidos/$(d.ultimaOferta)/cotizaciones/$(prov));
    }
    match /usos/{prov} {
      allow read: if actuaPor(prov);
      allow create, update: if actuaPor(prov)
        && request.resource.data.keys().hasOnly(['mes', 'solicitudes', 'respuestas', 'ultimaSolicitud', 'ultimaOferta'])
        && request.resource.data.mes == mesActual()
        && (sumaSolicitud(prov, request.resource.data) || sumaOferta(prov, request.resource.data));
      allow delete: if false;
    }

    // ── Equipo del plan Empresa
    function invitacionRuta(codigo) { return /databases/$(database)/documents/invitaciones/$(codigo); }
    function equipoRuta(emp) { return /databases/$(database)/documents/equipos/$(emp); }

    // El titular crea un enlace de un solo uso; quien lo tenga ve a qué empresa lo invitan (el código es largo y al azar).
    match /invitaciones/{codigo} {
      allow get: if true;
      allow list: if autenticado() && resource.data.empresaId == request.auth.uid;
      allow create: if autenticado()
        && codigo.size() >= 20
        && request.resource.data.keys().hasOnly(['empresaId', 'empresa', 'etiqueta', 'creada'])
        && request.resource.data.keys().hasAll(['empresaId', 'empresa', 'etiqueta', 'creada'])
        && request.resource.data.empresaId == request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && perfil(request.auth.uid).data.rol == 'proveedor'
        && planDe(request.auth.uid) == 'empresa'
        && texto(request.resource.data.empresa, 2, 120)
        && texto(request.resource.data.etiqueta, 0, 80)
        && request.resource.data.creada == request.time;
      // La borra el titular (cancelar) o quien se suma con ella, en el mismo lote.
      allow delete: if autenticado() && (resource.data.empresaId == request.auth.uid
        || getAfter(miembroRuta()).data.get('invitacion', '') == codigo);
      allow update: if false;
    }

    // Quien se suma: sin perfil propio, con una invitación vigente que se consume en el mismo lote y entrando en la lista.
    match /miembros/{uid} {
      allow read: if esDuenio(uid) || (autenticado() && resource.data.empresaId == request.auth.uid);
      allow create: if esDuenio(uid)
        && !exists(/databases/$(database)/documents/users/$(uid))
        && request.resource.data.keys().hasOnly(['empresaId', 'nombre', 'email', 'invitacion', 'desde'])
        && request.resource.data.keys().hasAll(['empresaId', 'nombre', 'email', 'invitacion', 'desde'])
        && texto(request.resource.data.nombre, 2, 80)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.desde == request.time
        && get(invitacionRuta(request.resource.data.invitacion)).data.empresaId == request.resource.data.empresaId
        && request.time < get(invitacionRuta(request.resource.data.invitacion)).data.creada + duration.value(7, 'd')
        && !existsAfter(invitacionRuta(request.resource.data.invitacion))
        && planDe(request.resource.data.empresaId) == 'empresa'
        && uid in getAfter(equipoRuta(request.resource.data.empresaId)).data.miembros;
      // Lo quita el titular, sacándolo de la lista en el mismo lote.
      allow delete: if autenticado() && resource.data.empresaId == request.auth.uid
        && !(uid in getAfter(equipoRuta(request.auth.uid)).data.miembros);
      allow update: if false;
    }

    // Hasta 4 miembros además del titular. Se suma de a uno (el que entra) y se quita de a uno (el titular).
    match /equipos/{emp} {
      allow read: if actuaPor(emp);
      allow create, update: if autenticado()
        && request.resource.data.keys().hasOnly(['miembros', 'ultimoQuitado'])
        && request.resource.data.miembros is list
        && request.resource.data.miembros.size() <= 4
        && (
          // Entra quien se suma con una invitación de esta empresa.
          (request.resource.data.miembros == (resource == null ? [] : resource.data.miembros).concat([request.auth.uid])
            && request.resource.data.get('ultimoQuitado', '') == anterior('ultimoQuitado')
            && getAfter(miembroRuta()).data.empresaId == emp)
          // El titular quita a uno y borra su miembros/{uid} en el mismo lote.
          || (request.auth.uid == emp && resource != null
            && request.resource.data.ultimoQuitado in resource.data.miembros
            && request.resource.data.miembros == resource.data.miembros.removeAll([request.resource.data.ultimoQuitado])
            && !existsAfter(/databases/$(database)/documents/miembros/$(request.resource.data.ultimoQuitado)))
        );
      allow delete: if false;
    }

    // ── Administradores: se agregan a mano desde la consola (documento admins/{uid}).
    function esAdmin() { return autenticado() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    match /admins/{uid} {
      allow read: if esDuenio(uid);
      allow write: if false;
    }

    // ── Referencias. Los valores los edita un administrador; el resto lo carga el equipo (scripts/sembrar.ts).
    function numeroOpcional(d, campo) { return !(campo in d) || (d[campo] is number && d[campo] >= 0); }
    function valorValido(d) {
      return d.keys().hasOnly(['rubro', 'concepto', 'tipo', 'unidad', 'principal', 'region', 'min', 'mediana', 'max',
                               'muestras', 'fuente', 'fuenteDetalle', 'fecha', 'actualizado', 'actualizadoPor'])
        && rubroValido(d.rubro)
        && texto(d.concepto, 2, 160)
        && d.tipo in ['hora', 'unidad', 'proyecto']
        && texto(d.unidad, 1, 40)
        && d.region in ['ros', 'amba', 'cba', 'noa', 'costa', 'nacional']
        && d.min is number && d.mediana is number && d.max is number
        && d.min >= 0 && d.min <= d.mediana && d.mediana <= d.max
        && numeroOpcional(d, 'muestras')
        && (!('principal' in d) || d.principal is bool)
        && (!('fuente' in d) || d.fuente in ['cotizaciones', 'arancel', 'convenio', 'estimado'])
        && textoOpcional(d, 'fuenteDetalle', 200)
        && (!('fecha' in d) || (d.fecha is string && d.fecha.matches('^[0-9]{4}-[0-9]{2}$')))
        && d.actualizado == request.time
        && d.actualizadoPor == request.auth.uid;
    }
    match /valoresReferencia/{id} {
      allow read: if tienePerfil();
      allow create, update: if esAdmin() && valorValido(request.resource.data);
      allow delete: if false;
    }
    // Centro de referencias: índices oficiales y escalas de convenio. Los consultan los compradores; los carga un admin.
    match /indicadores/{id} {
      allow read: if (tienePerfil() && miRol() == 'comprador') || esAdmin();
      allow create, update: if esAdmin()
        && request.resource.data.keys().hasOnly(['nombre', 'grupo', 'organismo', 'unidad', 'base', 'fuente', 'proximaPublicacion', 'nota', 'serie', 'actualizado'])
        && texto(request.resource.data.nombre, 1, 120)
        && request.resource.data.grupo in ['precios', 'construccion', 'salarios']
        && request.resource.data.unidad in ['puntos', 'mes', 'hora']
        && request.resource.data.serie is list && request.resource.data.serie.size() <= 240;
      allow delete: if false;
    }
    match /escalas/{id} {
      allow read: if (tienePerfil() && miRol() == 'comprador') || esAdmin();
      allow create, update: if esAdmin()
        && request.resource.data.keys().hasOnly(['actividad', 'convenio', 'periodo', 'vigenciaHasta', 'proximaRevision', 'nota', 'fuente', 'categorias', 'actualizado'])
        && request.resource.data.periodo is string && request.resource.data.periodo.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.categorias is list && request.resource.data.categorias.size() <= 40;
      allow delete: if false;
    }
    match /indicePrecios/{id} { allow read: if tienePerfil(); allow write: if false; }
    match /config/{doc} { allow read: if tienePerfil(); allow write: if false; }

    // ── Baja de la cuenta (Ley 25.326, supresión): el usuario la pide y el script de avisos borra todo
    // en la próxima corrida (cada 30 minutos). Un miembro de equipo también la pide, por su usuario.
    match /bajas/{uid} {
      allow read: if esDuenio(uid) || esAdmin();
      allow create: if esDuenio(uid)
        && request.resource.data.keys().hasOnly(['pedida'])
        && request.resource.data.pedida == request.time;
      allow update, delete: if false;
    }

    // ── Lista de espera del plan Equipo: el comprador se anota, el equipo la ve en /admin.
    match /listaEspera/{uid} {
      allow read: if esDuenio(uid) || esAdmin();
      allow create: if esDuenio(uid) && tienePerfil() && miRol() == 'comprador'
        && request.resource.data.keys().hasOnly(['plan', 'empresa', 'anotado'])
        && request.resource.data.plan == 'equipo'
        && request.resource.data.empresa == perfil(uid).data.empresa
        && request.resource.data.anotado == request.time;
      allow update: if false;
      allow delete: if esDuenio(uid) || esAdmin();
    }

    // ── Reseñas: una por pedido y proveedor ganador, del comprador que lo publicó. No se editan.
    // El id es el del pedido para el proveedor principal (adjudicadaA) y "{pedido}--{proveedor}" para los demás.
    function puntaje(v) { return v is int && v >= 1 && v <= 5; }
    match /resenas/{rid} {
      allow read: if tienePerfil();
      allow create: if autenticado()
        && request.resource.data.keys().hasOnly(['pedidoId', 'proveedorId', 'compradorId', 'entrega', 'calidad', 'facturacion', 'texto', 'autor', 'empresa', 'creada'])
        && request.resource.data.compradorId == request.auth.uid
        && pedido(request.resource.data.pedidoId).compradorId == request.auth.uid
        && pedido(request.resource.data.pedidoId).estado == 'adjudicado'
        && ((rid == request.resource.data.pedidoId && pedido(request.resource.data.pedidoId).adjudicadaA == request.resource.data.proveedorId)
          || (rid == request.resource.data.pedidoId + '--' + request.resource.data.proveedorId
              && request.resource.data.proveedorId in pedido(request.resource.data.pedidoId).get('adjudicados', [])))
        && puntaje(request.resource.data.entrega)
        && puntaje(request.resource.data.calidad)
        && puntaje(request.resource.data.facturacion)
        && texto(request.resource.data.texto, 20, 500)
        && texto(request.resource.data.autor, 1, 120)
        && texto(request.resource.data.empresa, 0, 120)
        && request.resource.data.creada == request.time;
      allow update, delete: if false;
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
