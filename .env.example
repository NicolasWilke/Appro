# browser | memory  (memory se usa para la demo publicada, que no puede cambiar la URL)
VITE_ROUTER=browser
# mock | api
VITE_DATA_SOURCE=mock
# Solo con VITE_DATA_SOURCE=api
VITE_API_URL=https://api.ejemplo.com

# ── Cuentas y login
# demo: todo en el navegador (sin mails reales) | firebase: cuentas en Firebase Authentication y datos en Firestore
VITE_AUTH=demo
# Valores de Configuración del proyecto → Tus apps → Web (firebaseConfig). Son públicos; los datos los protegen las reglas.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# true: usa los emuladores locales (npm run emuladores) en vez del proyecto real
VITE_FIREBASE_EMULADORES=false
# true solo con plan Blaze y Storage activado. En false (plan Spark) el logo se guarda achicado dentro del perfil.
VITE_FIREBASE_STORAGE=false

# ── Servidor: scripts sembrar, avisos y admin (leen este mismo .env.local; no van al navegador)
FIREBASE_PROJECT_ID=tu-proyecto
# Ruta al JSON de la cuenta de servicio. Ese archivo es una llave maestra: nunca lo subas al repositorio.
GOOGLE_APPLICATION_CREDENTIALS=./clave-servicio.json

# ── Servidor: envío de mails (nunca con prefijo VITE_, no van al navegador)
# consola | resend
MAIL_PROVIDER=consola
RESEND_API_KEY=
MAIL_FROM="APPRO <avisos@tudominio.com.ar>"
PUBLIC_URL=http://localhost:5173
# Solo para npm run mail:prueba con Resend: todos los mails de prueba van a esta dirección
MAIL_PRUEBA_A=
