# La app funciona sin ninguna variable: cuentas y datos se guardan en el navegador.

# browser | memory  (memory se usa para la demo publicada, que no puede cambiar la URL)
VITE_ROUTER=browser
# mock | api
VITE_DATA_SOURCE=mock
# Solo con VITE_DATA_SOURCE=api
VITE_API_URL=https://api.ejemplo.com

# ── Servidor: envío de mails de prueba (nunca con prefijo VITE_, no van al navegador)
# consola | resend
MAIL_PROVIDER=consola
RESEND_API_KEY=
MAIL_FROM="APPRO <avisos@tudominio.com.ar>"
PUBLIC_URL=http://localhost:5173
# Solo para npm run mail:prueba con Resend: todos los mails de prueba van a esta dirección
MAIL_PRUEBA_A=
